# Paysapro Prospection — configuration optionnelle.
# L'application fonctionne SANS aucune variable : copiez ce fichier en `.env.local` seulement si besoin.
#
# ⚠️ Toute variable VITE_* est intégrée dans le code envoyé au navigateur.
# N'y mettez JAMAIS de secret (clé d'API privée, mot de passe…).
# Il n'y a volontairement ni DATABASE_URL (les données sont dans IndexedDB, sur l'appareil)
# ni AI_API_KEY (une clé ne doit jamais se trouver dans un site statique).

# Nom du SaaS présenté dans les messages de prospection (modifiable aussi dans Paramètres)
VITE_SAAS_NAME=Paysapro AI

# IA optionnelle : URL de VOTRE petit proxy (ex. Cloudflare Worker gratuit) qui détient la clé d'API.
# Vide = « IA non configurée » : les messages sont générés par les modèles dynamiques.
# Voir PROSPECTING.md § IA.
VITE_AI_ENDPOINT=

# Source SIRENE (API publique gratuite, sans clé). À ne changer que si l'API déménage.
VITE_SIRENE_API_URL=https://recherche-entreprises.api.gouv.fr
