# Normandie Business Radar — exemple de configuration locale (copier en .env, ne jamais committer .env).
# En production Cloudflare, ces valeurs sont des « secrets » du Worker (npx wrangler secret put NOM).

# Secret de l'application (au moins 32 caractères aléatoires) — signe les jetons internes.
APP_SECRET=
# Jeton à usage unique permettant de créer le premier compte depuis /installation.
SETUP_TOKEN=
# Base SQLite locale (Node) et dossier des documents.
DATABASE_PATH=./data/radar.db
FILES_DIR=./data/files
PORT=8788
# Départements couverts (séparés par des virgules). Ajout de 27,14,50,61 sans réécriture.
DEPARTMENTS=76

# --- Connecteurs facultatifs (les sources gratuites sans clé fonctionnent sans eux) ---
# INSEE — API Sirene (portail https://portail-api.insee.fr, clé gratuite, en-tête X-INSEE-Api-Key-Integration)
INSEE_API_KEY=
# INPI — Registre national des entreprises (compte gratuit https://data.inpi.fr, accès API à demander)
INPI_USERNAME=
INPI_PASSWORD=
# Pappers — API payante avec crédits gratuits limités (https://www.pappers.fr/api)
PAPPERS_API_TOKEN=
# RADAR AI — modèle externe FACULTATIF (Anthropic). Sans clé, l'assistant fonctionne en mode déterministe local.
ANTHROPIC_API_KEY=
