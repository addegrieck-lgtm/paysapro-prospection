{
  "name": "normandie-business-radar",
  "private": true,
  "version": "0.1.0",
  "description": "Normandie Business Radar — intelligence économique, transmission et acquisition d'entreprises en Seine-Maritime (76).",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server/node.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "tsx src/server/node.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "user:create": "tsx scripts/create-user.ts",
    "sync": "tsx scripts/sync.ts",
    "deploy": "node scripts/cf-deploy.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "hono": "^4.13.16",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.6",
    "@tailwindcss/vite": "^4.3.4",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^9.2.0",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
