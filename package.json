{
  "name": "paysapro-prospection",
  "private": true,
  "version": "0.1.0",
  "description": "Prospection B2B des paysagistes français — application indépendante, 100 % locale et gratuite.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
