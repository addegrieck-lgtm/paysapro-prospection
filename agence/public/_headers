# En-têtes des fichiers statiques sur Cloudflare (Workers Static Assets). Ce fichier n'est pas publié.
# Les polices ne changent jamais de contenu sous un même nom : cache long.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
# CSS, JS et images ne sont pas versionnés dans leur nom : cache court + revalidation en arrière-plan.
/assets/css/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/assets/js/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/assets/img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
