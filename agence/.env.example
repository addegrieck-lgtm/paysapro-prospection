# Agence — configuration du serveur Node (copier en .env, jamais dans Git).
# Sur Cloudflare Workers, ces valeurs sont des « secrets » (wrangler secret put …) ou des [vars] de wrangler.toml.

# OBLIGATOIRE en production : 32 caractères minimum, aléatoire. Générer : openssl rand -hex 32
APP_SECRET=

# Jeton à usage unique pour créer le premier administrateur via /admin/installation.
# Supprimez-le après la création du compte (ou utilisez plutôt : npm run admin:create).
ADMIN_SETUP_TOKEN=

NODE_ENV=production
PORT=3000
# 1 si le serveur est derrière un proxy (Nginx, Caddy, Render…) qui transmet X-Forwarded-For
TRUST_PROXY=0

# Base SQLite et fichiers privés (en dehors du dossier public ; à sauvegarder)
DATABASE_PATH=./data/agence.db
UPLOAD_DIR=./data/uploads

# E-mails transactionnels : log (simulation) | brevo | resend
MAIL_PROVIDER=log
BREVO_API_KEY=
RESEND_API_KEY=
# Adresse d'expédition vérifiée chez le fournisseur d'e-mails (ex. contact@votre-domaine.fr)
MAIL_FROM=
MAIL_FROM_NAME=
